# Tutto facoltativo. Senza questo file l'app usa il database locale (PGlite)
# nella cartella dati/ del progetto.
#
# Per usare Neon: copia questo file in .env.local e metti la TUA connection
# string. .env.local è escluso da git: non committare mai la connection string.
DATABASE_URL=postgresql://utente:password@host/database?sslmode=require
# CARTELLA_DATI=dati
# PORTA_API=3001
